<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.greenlast.dao.dongha.IPermitClassDao">

    <select id="getClassById" parameterType="int" resultType="com.example.greenlast.dto.ClassDTO">
        SELECT * FROM class WHERE class_id = #{classId}
    </select>

    <select id="getPendingClasses" resultType="com.example.greenlast.dto.ClassDTO">
        SELECT * FROM class WHERE class_permit = 'n'
    </select>

    <update id="approveClass">
        UPDATE class SET class_permit = 'y' WHERE class_id = #{classId}
    </update>

    <update id="rejectClass">
        UPDATE class SET class_permit = 'n' WHERE class_id = #{classId}
    </update>

    <select id="getSectionByClassId" resultType="com.example.greenlast.dto.ClassSectionDTO">
        SELECT
            section_id AS sectionId,
            class_id As classId,
            section_title AS classTitle,
            class_permit AS classPermit
        FROM class_section
        WHERE class_id = #{classId}
    </select>

    <select id="getLessonsBySectionId" resultType="com.example.greenlast.dto.ClassLessonDTO">
        SELECT
            cl.lesson_id AS lessonId,
            cl.section_id AS sectionId,
            cl.lesson_title AS lessonTitle,
            cl.file_no, f.file_url
        FROM class_lesson cl
        LEFT JOIN file f ON cl.file_no = f.file_no
        WHERE cl.section_id = #{sectionId}
        ORDER BY cl.lesson_id;
    </select>

    <resultMap id="lessonResultMap" type="com.example.greenlast.dto.ClassLessonDTO">
        <id property="lessonId" column="lesson_id"/>
        <result property="sectionId" column="section_id"/>
        <result property="lessonTitle" column="lesson_title"/>
        <result property="lessonContent" column="lesson_content"/>
        <result property="lessonFree" column="lesson_free"/>
        <result property="fileNo" column="file_no"/>
        <result property="fileUrl" column="file_url"/>
    </resultMap>

</mapper>
