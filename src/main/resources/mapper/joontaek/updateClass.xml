<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.greenlast.dao.joontaek.UpdateClassDao">

    <select id="getClassInfo" parameterType="int" resultType="com.example.greenlast.dto.ClassDTO">
        SELECT * FROM class WHERE class_id = #{classId}
    </select>

    <select id="getThumbnailImg" resultType="com.example.greenlast.dto.FileDTO">
        SELECT * FROM file WHERE file_no = #{fileNo}
    </select>

    <update id="updateClassInfo">
        UPDATE class SET class_title = #{classTitle} , description = #{description}, class_price = #{classPrice}, class_category = #{classCategory} ,
        class_create_date = NOW(),  class_permit = #{classPermit} , class_recom = #{classRecom} , class_level = #{classLevel} , file_no = #{fileNo}
        WHERE class_id = #{classId}
    </update>

    <select id="getSectionByClassId" resultType="com.example.greenlast.dto.ClassSectionDTO">
        SELECT
        section_id AS sectionId,
        class_id As classId,
        section_title AS title,
        class_permit AS classPermit
        FROM class_section
        WHERE class_id = #{classId}
    </select>

    <select id="getLessonsBySectionId" resultType="com.example.greenlast.dto.ClassLessonDTO">
        SELECT
        cl.lesson_id AS lessonId,
        cl.section_id AS sectionId,
        cl.lesson_title AS lessonTitle,
        cl.file_no, f.file_url
        FROM class_lesson cl
        LEFT JOIN file f ON cl.file_no = f.file_no
        WHERE cl.section_id = #{sectionId}
        ORDER BY cl.lesson_id;
    </select>


    <!-- GPT@@@@@@@@@@@@@@@@@@@@@@@@@@@ !-->
    <!-- GPT@@@@@@@@@@@@@@@@@@@@@@@@@@@ !-->
    <!-- GPT@@@@@@@@@@@@@@@@@@@@@@@@@@@ !-->
    <!-- GPT@@@@@@@@@@@@@@@@@@@@@@@@@@@ !-->

    <resultMap id="SectionResultMap" type="com.example.greenlast.dto.SectionDTO">
        <!-- SectionDTO -->
        <id property="sectionId" column="section_id"/>
        <result property="title" column="section_title"/>

        <!-- lessons: collection(1:N) -->
        <collection property="lessons" ofType="com.example.greenlast.dto.SectionDTO$Lesson">
            <id property="lessonId" column="lesson_id"/>
            <result property="title" column="lesson_title"/>

            <!-- video: association(1:1) -->
            <association property="video" javaType="com.example.greenlast.dto.SectionDTO$Lesson$Video">
                <result property="fileNo" column="file_no"/>
                <result property="fileName" column="file_name"/>
                <result property="fileUrl" column="file_url"/>
                <result property="fileSize" column="file_size"/>
                <!-- hasVideo → CASE WHEN or TypeHandler 등으로 DB -> boolean 변환 -->
                <result property="hasVideo" column="has_video"/>
            </association>
        </collection>
    </resultMap>

    <select id="getSections" resultMap="SectionResultMap">
        SELECT
        cs.section_id,
        cs.section_title,
        cl.lesson_id,
        cl.lesson_title,
        f.file_no,
        f.file_old_name AS file_name,
        f.file_url,
        f.file_size,
        CASE WHEN f.file_no IS NOT NULL THEN 1 ELSE 0 END AS has_video
        FROM class_section cs
        LEFT JOIN class_lesson cl ON cs.section_id = cl.section_id
        LEFT JOIN file f ON f.file_no = cl.file_no
        WHERE cs.class_id = #{classId}
        ORDER BY cs.section_id, cl.lesson_id
    </select>

    <select id="getOriSectionId" resultType="java.lang.Long">
        SELECT section_id FROM class_section
    </select>

    <select id="getOriLessonId" resultType="java.lang.Long">
        SELECT lesson_id FROM class_lesson
    </select>

    <update id="updateSection">
        UPDATE class_section SET section_title = #{sectionTitle} , class_permit = 'N' where section_id = #{sectionId}
    </update>

    <insert id="updateNewSection">
        INSERT INTO class_section (section_id,class_id,section_title,class_permit)
        VALUES
        (NULL,#{classId},#{sectionTitle},'N')
    </insert>

    <update id="updateLesson">
        UPDATE class_lesson SET lesson_title = #{lessonTitle} WHERE lesson_id = #{lessonId}
    </update>

    <insert id="updateNewLesson">
        INSERT INTO class_lesson (lesson_id,section_id,lesson_title) VALUES
        (null,#{sectionId},#{lessonTitle})
    </insert>

    <delete id="deleteSection">
        DELETE FROM class_section WHERE section_id = #{sectionId}
    </delete>

    <delete id="deleteLesson">
        DELETE FROM class_lesson WHERE lesson_id = #{lessonId}
    </delete>


</mapper>